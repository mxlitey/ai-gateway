# 构建上下文精简：排除本机状态、构建产物与依赖，避免打进镜像
.git
.github
dist
data
plugins
*.db
*.db-shm
*.db-wal
web/node_modules
web/dist
build
docs
# Docker 验证用的构建产物与脚本需要参与构建上下文
!out
!examples/docker-test
examples/*/*.exe
examples/*/*.cmd
*.exe
*.syso
.idea
.vscode
*.log
Dockerfile
.dockerignore
docker-compose.yml
# Python 字节码缓存不进构建上下文（examples 下的插件源码会被拷进镜像）
**/__pycache__
**/*.pyc
